#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

COMPOSE_FILE="$ROOT_DIR/docker-compose.yml"

if ! command -v docker >/dev/null 2>&1; then
  echo "Error: docker is not installed or not on PATH."
  exit 1
fi

run_compose() {
  docker compose -f "$COMPOSE_FILE" "$@"
}

print_help() {
  cat <<'EOF'
Usage: manage_pm <start|stop|restart|status|help>

Commands:
  start    Build and start the docker compose stack
  stop     Stop and remove the docker compose stack
  restart  Restart the docker compose stack
  status   Show compose service status
  help     Show this help message
EOF
}

start_stack() {
  run_compose up -d --build
  echo
  echo "Stack started."
  echo "Static page: http://localhost:8080"
  echo "Backend API: http://localhost:18000/api/hello"
}

stop_stack() {
  run_compose down
  echo "Stack stopped."
}

status_stack() {
  run_compose ps
}

case "${1:-help}" in
start)
  start_stack
  ;;
stop)
  stop_stack
  ;;
restart)
  stop_stack
  start_stack
  ;;
status)
  status_stack
  ;;
help|-h|--help)
  print_help
  ;;
*)
  echo "Unknown command: $1"
  print_help
  exit 1
  ;;
esac
